OPENWEATHERMAP_API_KEY=

# civic_api — 10.0.2.2 est l'alias que l'émulateur Android utilise pour
# atteindre le localhost de la machine hôte (cible par défaut du projet).
# Sur un appareil physique, remplacer par l'IP locale de la machine qui fait
# tourner civic_api. Sur cible web (chrome/edge) ou desktop, utiliser
# http://localhost:4000 à la place.
API_BASE_URL=http://10.0.2.2:4000
